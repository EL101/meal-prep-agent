# Copy to backend/.env. Never commit the real file.
ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mealprep
REDIS_URL=redis://localhost:6379

# Supabase → Project Settings → API / JWT
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still on the legacy HS256 JWT secret; leave blank to verify via JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=inventory-images

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

USDA_API_KEY=
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
BLS_API_KEY=

CORS_ORIGINS=["http://localhost:8081"]
