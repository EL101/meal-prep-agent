{
  "expo": {
    "name": "Muscle Mom",
    "slug": "mobile",
    "scheme": "musclemom",
    "platforms": [
      "ios",
      "web"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.musclemom.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-apple-authentication"
    ]
  }
}
