# Copy to .env.local and fill in. EXPO_PUBLIC_ values are bundled into the app, so only
# public values go here: never the Supabase secret key.

# Supabase → Project Settings → API Keys (the publishable key, sb_publishable_...)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The FastAPI backend. On a physical phone use your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google Cloud → APIs & Services → Credentials (OAuth client IDs)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
